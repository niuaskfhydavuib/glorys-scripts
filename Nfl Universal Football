-- // Tackle Reach — when the ball carrier's hitbox is within range, snaps it onto you for 0.1s.
-- The carrier search runs at most every 0.2s, and only one 0.1s hitbox move runs at a time.
do
	local tackleReachEnabled = false
	local tackleReachDistance = 5
	local tackleReachTransparency = 1
	local tackleReachConnection = nil

	local function resetHitboxes()
		local hbf = getHitboxFolder()
		if hbf then
			for _, hb in ipairs(hbf:GetChildren()) do
				if hb:IsA("BasePart") then hb.Transparency = 1 end
			end
		end
	end

	local function setTackleReach(v)
		tackleReachEnabled = v
		if tackleReachConnection then tackleReachConnection:Disconnect() tackleReachConnection = nil end
		if v then
			local carrier, nextScan, busy = nil, 0, false
			tackleReachConnection = RunService.Heartbeat:Connect(function()
				local now = os.clock()
				if now >= nextScan then
					nextScan = now + 0.2
					carrier = nil
					for _, tp in ipairs(Players:GetPlayers()) do
						local c = tp ~= plr and tp.Character
						if c and (c:FindFirstChild("Football") or c:FindFirstChild("FootballGrip", true)) then
							carrier = tp
							break
						end
					end
				end
				if not carrier or not carrier.Character then return end

				local hbf = getHitboxFolder()
				local hb = hbf and hbf:FindFirstChild(carrier.Name)
				if not hb then return end
				if hb.Transparency ~= tackleReachTransparency then hb.Transparency = tackleReachTransparency end

				if busy or not humanoidRootPart then return end
				if (hb.Position - humanoidRootPart.Position).Magnitude <= tackleReachDistance then
					busy = true
					local tp = carrier
					hb.Position = humanoidRootPart.Position
					task.delay(0.1, function()
						local hrp = tp.Character and tp.Character:FindFirstChild("HumanoidRootPart")
						if hrp and hb.Parent then hb.Position = hrp.Position end
						busy = false
					end)
				end
			end)
		else
			resetHitboxes()
		end
	end
	table.insert(Cleanups, function() if tackleReachEnabled then setTackleReach(false) end end)

	local Section = HitboxTab:AddSection({ Name = "tackle reach", Side = "Left" })
	Section:AddToggle({ Name = "tackle reach", Default = false, Callback = setTackleReach })
	Section:AddSlider({ Name = "tackle reach distance", Min = 1, Max = 10, Default = 5, Suffix = " studs", Callback = function(v) tackleReachDistance = v end })
	Section:AddSlider({ Name = "carrier hitbox transparency", Min = 0, Max = 1, Rounding = 2, Default = 1, Callback = function(v) tackleReachTransparency = v end })
end

-- // Auto Stick — while airborne, eases you onto the closest head in range; stops once you
-- reach it, re-arms on landing. Skipped while tackled/ragdolled or moving fast horizontally.
do
	local stickEnabled       = false
	local balanceRadius      = 5.5
	local verticalRangeMin   = -3
	local verticalRangeMax   = 7
	local correctionSpeed    = 5
	local randomOffset       = 0.015
	local pullCooldown       = 0.15
	local yOffset            = 3.2
	local MAX_HORIZONTAL_SPEED = 45
	local REACHED_DISTANCE     = 0.65

	local reachedHead = false
	local lastPull    = 0

	local function isInAir()
		return humanoid:GetState() == Enum.HumanoidStateType.Freefall
			or humanoid.FloorMaterial == Enum.Material.Air
	end

	local function isBeingTackled()
		local state = humanoid:GetState()
		return state == Enum.HumanoidStateType.Ragdoll
			or state == Enum.HumanoidStateType.Physics
			or humanoid.PlatformStand
	end

	local function findClosestHead()
		local closestHead, shortestDistance = nil, math.huge
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= plr and p.Character then
				local h = p.Character:FindFirstChild("Head")
				if h then
					local dist = (h.Position - humanoidRootPart.Position).Magnitude
					if dist < balanceRadius and dist < shortestDistance then
						shortestDistance = dist
						closestHead = h
					end
				end
			end
		end
		return closestHead
	end

	Connect(RunService.Heartbeat, function(dt)
		if not stickEnabled or not humanoid or not humanoidRootPart or not humanoidRootPart.Parent then return end

		if not isInAir() then
			reachedHead = false
			lastPull = 0
			return
		end

		if isBeingTackled() then
			reachedHead = false
			return
		end

		if reachedHead then return end

		local vel = humanoidRootPart.AssemblyLinearVelocity
		if Vector3.new(vel.X, 0, vel.Z).Magnitude > MAX_HORIZONTAL_SPEED then return end

		local now = tick()
		if now - lastPull < pullCooldown then return end

		local targetHead = findClosestHead()
		if not targetHead then return end

		local myPos   = humanoidRootPart.Position
		local headPos = targetHead.Position

		local flatDist = (Vector3.new(headPos.X, 0, headPos.Z) - Vector3.new(myPos.X, 0, myPos.Z)).Magnitude
		if flatDist < 0.5 then return end

		local verticalDiff = myPos.Y - headPos.Y
		if verticalDiff < verticalRangeMin or verticalDiff > verticalRangeMax then return end

		local targetPos = Vector3.new(
			headPos.X + (math.random() - 0.5) * randomOffset,
			headPos.Y + yOffset,
			headPos.Z + (math.random() - 0.5) * randomOffset
		)

		if (myPos - targetPos).Magnitude < REACHED_DISTANCE then
			reachedHead = true
			return
		end

		local alpha = math.clamp(correctionSpeed * dt, 0, 0.65)
		local smoothPos = myPos:Lerp(targetPos, alpha)
		humanoidRootPart.CFrame = CFrame.new(smoothPos, smoothPos + humanoidRootPart.CFrame.LookVector)
	end)

	local Section = HitboxTab:AddSection({ Name = "auto stick", Side = "Right" })
	Section:AddLabel({ Text = "in the air, eases you onto the closest head in range" })
	Section:AddToggle({ Name = "auto stick", Default = false, Callback = function(v) stickEnabled = v; reachedHead = false end })
	Section:AddSlider({ Name = "stick speed", Min = 1, Max = 10, Rounding = 1, Default = 5, Callback = function(v) correctionSpeed = v end })
end

