-- // Physics
-- Some modes change ball gravity or speed. The game sets both from the GameParams in the game folder; the rest are constants.
local Gravity, GravityVector, TimeScale = 28, Vector3.new(0, -28, 0), 1
local SpeedPerPower, MinPower, MaxPower = 0.95, 30, 100
local MinSpeed, MaxSpeed = MinPower * SpeedPerPower, MaxPower * SpeedPerPower
local MaxAirTime = 6
local MaxArcAngle = math.rad(75)
local ReleaseOffset = CFrame.new(1, 1.5, 0)

local function UpdatePhysics()
	if Physics then
		Gravity = math.max(math.abs(tonumber(Physics.Gravity) or 28), 1)
		TimeScale = math.max(tonumber(Physics.TimeScale) or 1, 0.05)
		SpeedPerPower = tonumber(Physics.MaximumPowerCoefficient) or 0.95
		MinPower = tonumber(Physics.MinPower) or 30
		MaxPower = tonumber(Physics.MaxPower) or 100
		MaxAirTime = tonumber(Physics.MaxTimeInAir) or 6
	else
		local Params = GetGameSettings()
		Params = Params and Params:FindFirstChild("GameParams")
		-- The game ignores a positive gravity value, so that keeps the default.
		local GravityParam = tonumber(GetValue(Params, "FootballGravity"))
		Gravity = (GravityParam and GravityParam <= 0) and math.max(-GravityParam, 1) or 28
		TimeScale = math.max(tonumber(GetValue(Params, "FootballSpeed")) or 1, 0.05)
	end
	GravityVector = Vector3.new(0, -Gravity, 0)
	MinSpeed, MaxSpeed = MinPower * SpeedPerPower, MaxPower * SpeedPerPower
end
UpdatePhysics()

