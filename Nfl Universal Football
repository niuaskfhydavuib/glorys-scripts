-- // Configs
-- Wisteria only keeps values in memory. Every toggle / slider / dropdown / textbox / keybind /
-- color picker made on a tab (except settings) is registered here in creation order, keyed by
-- tab/section/type/name, so it can be saved to and loaded from Volzy/NFL-Universe/<name>.json.
local Configs = { Elements = {}, Keys = {} }
do
	local SaveKinds = { AddToggle = "Toggle", AddSlider = "Slider", AddDropdown = "Dropdown", AddTextBox = "TextBox", AddKeybind = "Keybind", AddColorPicker = "ColorPicker" }

	local function TrackSections(Tab, TabName)
		local RawAddSection = Tab.AddSection
		Tab.AddSection = function(Self, SectionOptions)
			local Section = RawAddSection(Self, SectionOptions)
			local SectionName = SectionOptions and SectionOptions.Name or "section"
			for Method, Kind in next, SaveKinds do
				local Raw = Section[Method]
				Section[Method] = function(SectionSelf, ElementOptions)
					local Object = Raw(SectionSelf, ElementOptions)
					local Base = TabName .. "/" .. SectionName .. "/" .. Kind .. "/" .. tostring(ElementOptions.Name)
					local Key, Count = Base, 1
					while Configs.Keys[Key] do
						Count += 1
						Key = Base .. "#" .. Count
					end
					Configs.Keys[Key] = true
					table.insert(Configs.Elements, { Key = Key, Kind = Kind, Object = Object })
					return Object
				end
			end
			return Section
		end
	end

	local RawAddTab = Window.AddTab
	Window.AddTab = function(Self, TabOptions)
		local Tab = RawAddTab(Self, TabOptions)
		if TabOptions.Name ~= "settings" then
			TrackSections(Tab, TabOptions.Name)
		end
		return Tab
	end
end

