local equipped = {}
local activeToggles = {}
local templateCache = {}
local origShirtTemplate = nil
local origPantsTemplate = nil

do
	local s = character:FindFirstChildOfClass("Shirt")
	local p = character:FindFirstChildOfClass("Pants")
	if s then origShirtTemplate = s.ShirtTemplate end
	if p then origPantsTemplate = p.PantsTemplate end
end

local function applyTemplate(itemType, template, name)
	local char = player.Character
	if not char then return nil end
	if itemType == "Shirt" then
		local old = char:FindFirstChildOfClass("Shirt")
		if old then old:Destroy() end
		local s = Instance.new("Shirt")
		s.Name = name
		s.ShirtTemplate = template
		s.Parent = char
		return s
	else
		local old = char:FindFirstChildOfClass("Pants")
		if old then old:Destroy() end
		local p = Instance.new("Pants")
		p.Name = name
		p.PantsTemplate = template
		p.Parent = char
		return p
	end
end

local function tryGetTemplateFromAsset(itemType, assetId)
	if not assetId or assetId == 0 then return nil end
	local idStr = tostring(assetId)
	local ok, result = pcall(function()
		return game:GetObjects("rbxassetid://"..idStr)
	end)
	if ok and result then
		for _, obj in ipairs(result) do
			if obj:IsA(itemType) then
				return itemType == "Shirt" and obj.ShirtTemplate or obj.PantsTemplate
			end
			for _, child in ipairs(obj:GetDescendants()) do
				if child:IsA(itemType) then
					return itemType == "Shirt" and child.ShirtTemplate or child.PantsTemplate
				end
			end
		end
	end
	local ok2, model = pcall(function()
		return game:GetService("InsertService"):LoadAsset(assetId)
	end)
	if ok2 and model then
		local template = nil
		for _, child in ipairs(model:GetDescendants()) do
			if child:IsA(itemType) then
				template = itemType == "Shirt" and child.ShirtTemplate or child.PantsTemplate
				break
			end
		end
		pcall(function() model:Destroy() end)
		if template then return template end
	end
	return "rbxassetid://"..idStr
end

local function resolveTemplate(name)
	if templateCache[name] then return templateCache[name] end
	local d = CLOTHING_ITEMS[name]
	if not d then return nil end
	local template = nil
	if d.assetId and d.assetId ~= 0 then
		template = tryGetTemplateFromAsset(d.type, d.assetId)
	end
	if template and template ~= "" then
		templateCache[name] = template
	end
	return template
end

local function equipMesh(name)
	if equipped[name] then return end
	local d = CLOTHING_ITEMS[name]
	if not d or d.type ~= "Mesh" then return end
	local char = player.Character
	if not char then return end
	local parts = {}

	local par = char:FindFirstChild(d.par)
	if par then
		local part = Instance.new("Part")
		part.Name = name
		part.Size = Vector3.new(1,1,1)
		part.CanCollide = false
		part.Anchored = false
		part.Massless = true
		part.Parent = char
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.FileMesh
		m.MeshId = d.meshId
		m.TextureId = d.textureId
		m.Scale = d.scl
		m.Parent = part
		local w = Instance.new("Motor6D")
		w.Part0 = par
		w.Part1 = part
		w.C0 = d.off
		w.Parent = par
		table.insert(parts, part)
	end

	if #parts > 0 then
		equipped[name] = parts
	end
end

local function equipClothing(name)
	local d = CLOTHING_ITEMS[name]
	if d and d.type == "Mesh" then
		equipMesh(name)
		return
	end
	pcall(function()
		if not d then return end
		local char = player.Character
		if not char then return end
		local template = resolveTemplate(name)
		if not template then return end
		local current = char:FindFirstChildOfClass(d.type)
		if current then
			local currentTemplate = d.type == "Shirt" and current.ShirtTemplate or current.PantsTemplate
			if currentTemplate == template and current.Name == name then
				equipped[name] = {current}
				return
			end
		end
		local applied = applyTemplate(d.type, template, name)
		if applied then
			equipped[name] = {applied}
		end
	end)
end

local function unequipItem(name)
	local d = CLOTHING_ITEMS[name]
	if not d then return end
	if equipped[name] then
		for _, p in ipairs(equipped[name]) do
			if typeof(p) == "Instance" and p.Parent then
				p:Destroy()
			end
		end
		equipped[name] = nil
	end
	if d.type == "Mesh" then return end
	local char = player.Character
	if not char then return end
	if d.type == "Shirt" and origShirtTemplate then
		if not char:FindFirstChildOfClass("Shirt") then
			local s = Instance.new("Shirt"); s.ShirtTemplate = origShirtTemplate; s.Parent = char
		end
	elseif d.type == "Pants" and origPantsTemplate then
		if not char:FindFirstChildOfClass("Pants") then
			local p = Instance.new("Pants"); p.PantsTemplate = origPantsTemplate; p.Parent = char
		end
	end
end


-- Clothing persistence loop
task.spawn(function()
	while State.Running do
		task.wait(0.5)
		local char = player.Character
		if char then
			for name, _ in pairs(activeToggles) do
				local d = CLOTHING_ITEMS[name]
				if d then
					local needsReapply = false
					if not equipped[name] then
						needsReapply = true
					else
						local valid = false
						for _, inst in ipairs(equipped[name]) do
							if typeof(inst) == "Instance" and inst.Parent == char then
								valid = true
								break
							end
						end
						if not valid then needsReapply = true end
					end
					if d.type ~= "Mesh" and not needsReapply then
						local current = char:FindFirstChildOfClass(d.type)
						local cached = templateCache[name]
						if cached and current then
							local currentTemplate = d.type == "Shirt" and current.ShirtTemplate or current.PantsTemplate
							if currentTemplate ~= cached then needsReapply = true end
						elseif not current then
							needsReapply = true
						end
					end
					if needsReapply then
						equipClothing(name)
					end
				end
			end
		end
	end
end)

Connect(player.CharacterAdded, function(char)
	character = char
	char:WaitForChild("Humanoid")
	task.wait(0.5)
	for name, _ in pairs(activeToggles) do
		equipped[name] = nil
		equipClothing(name)
	end
end)


