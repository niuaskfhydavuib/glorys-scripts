-- // No Catch Outline — destroys the white highlight/outline put on your character when
-- you catch. Only looks at your own character, so the ball landing indicator is untouched.
do
	local noOutlineEnabled = false
	local outlineConnection = nil
	local OUTLINE_TYPES = { "Highlight", "SelectionBox", "SelectionSphere", "BoxHandleAdornment", "SphereHandleAdornment" }

	local function isOutline(obj)
		for _, t in ipairs(OUTLINE_TYPES) do
			if obj:IsA(t) then return true end
		end
		return false
	end

	local function removeOutline(obj)
		if noOutlineEnabled and isOutline(obj) then
			task.defer(function()
				if obj.Parent then obj:Destroy() end
			end)
		end
	end

	local function clearOutlines(char)
		if not char then return end
		for _, obj in ipairs(char:GetDescendants()) do removeOutline(obj) end
	end

	local function watch(char)
		if outlineConnection then outlineConnection:Disconnect() end
		outlineConnection = char.DescendantAdded:Connect(removeOutline)
	end
	table.insert(Cleanups, function() if outlineConnection then outlineConnection:Disconnect() end end)

	if plr.Character then watch(plr.Character) end
	Connect(plr.CharacterAdded, function(char)
		watch(char)
		task.wait(0.3)
		clearOutlines(char)
	end)

	local Section = MiscTab:AddSection({ Name = "no catch outline", Side = "Right" })
	Section:AddLabel({ Text = "removes the white outline when you catch. landing indicator untouched" })
	Section:AddToggle({ Name = "no catch outline", Default = false, Callback = function(v)
		noOutlineEnabled = v
		if v then clearOutlines(plr.Character) end
	end })
end

