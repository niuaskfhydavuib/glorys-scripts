local CLOTHING_SECTIONS = {
	{ title = "hairs",            match = function(d) return d.category == "Hair" end },
	{ title = "hats",             match = function(d) return d.category == "Hat" end },
	{ title = "head accessories", match = function(d) return d.category == "HeadAccessory" end },
	{ title = "neck",             match = function(d) return d.category == "Neck" end },
	{ title = "shirts",           match = function(d) return d.type == "Shirt" end },
	{ title = "pants",            match = function(d) return d.type == "Pants" end },
	{ title = "front items",      match = function(d) return d.category == "Vest" end },
}

for _, sectionInfo in ipairs(CLOTHING_SECTIONS) do
	local Section = ClothingTab:AddSection({ Name = sectionInfo.title })
	for _, name in ipairs(CLOTHING_ORDER) do
		local d = CLOTHING_ITEMS[name]
		if d and sectionInfo.match(d) then
			Section:AddToggle({ Name = name, Default = false, Callback = function(Value)
				if Value then
					activeToggles[name] = true
					equipClothing(name)
				else
					activeToggles[name] = nil
					unequipItem(name)
				end
			end })
		end
	end
end
