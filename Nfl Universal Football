	local function equipBanner(id)
		local imageIdStr = "rbxassetid://" .. tostring(id)
		for _, gui in pairs(plr.PlayerGui:GetDescendants()) do
			if gui.Name == "BaseImage" and gui:IsA("ImageLabel") then
				pcall(function() gui.Image = imageIdStr end)
			end
		end
		local char = plr.Character
		if char then
			for _, v in pairs(char:GetDescendants()) do
				if v.Name == "BaseImage" and v:IsA("ImageLabel") then
					pcall(function() v.Image = imageIdStr end)
				end
			end
			for _, desc in ipairs(char:GetDescendants()) do
				if desc:IsA("Decal") then
					local part = desc.Parent
					if part and (
						part.Name:lower():find("banner") or
						part.Name:lower():find("tag") or
						part.Name:lower():find("street")
					) then
						pcall(function() desc.Texture = imageIdStr end)
					end
				end
			end
		end
		for _, gui in pairs(plr.PlayerGui:GetDescendants()) do
			if gui.Name == "Content" and gui:IsA("ImageLabel") then
				local parent = gui.Parent
				if parent and parent.Name == "Icons" then
					pcall(function() gui.Image = imageIdStr end)
				end
			end
		end
	end


	local bannerNames = {}
	for _, b in ipairs(banners) do
		table.insert(bannerNames, b.name)
	end

	local function applyBanner(selected)
		for _, b in ipairs(banners) do
			if b.name == selected then
				equipBanner(b.id)
				break
			end
		end
	end

	local Section = BannersTab:AddSection({ Name = "banners", Side = "Left" })
	Section:AddLabel({ Text = "select a banner from the dropdown and click apply" })
	local BannerDropdown = Section:AddDropdown({ Name = "select banner", Options = bannerNames, Default = bannerNames[1], Callback = applyBanner })
	Section:AddButton({ Name = "apply banner", ButtonText = "apply", Callback = function()
		applyBanner(BannerDropdown:Get())
	end })
end


do
	local Tab = Window:AddTab({ Name = "settings", Icon = "settings" })
	local Menu = Tab:AddSection({ Name = "menu", Side = "Left" })
	Menu:AddKeybind({ Name = "menu key", Default = Enum.KeyCode.LeftControl, Callback = function(Key) Window:UpdateToggleKey(Key) end })
	Menu:AddButton({ Name = "unload", ButtonText = "unload", Callback = function() Environment.SaintsSupplementUnload() end })

	-- // Config files
	local HttpService = game:GetService("HttpService")
	local Folder = "Volzy/NFL-Universe"
	local AutoloadFile = Folder .. "/autoload.txt"
	local CanSave = writefile and readfile and isfile and isfolder and makefolder and listfiles

	local function EnsureFolder()
		if not isfolder("Volzy") then makefolder("Volzy") end
		if not isfolder(Folder) then makefolder(Folder) end
	end

	local function Encode(Element)
		local Value = Element.Object:Get()
		if Element.Kind == "Keybind" then
			return typeof(Value) == "EnumItem" and (tostring(Value.EnumType) .. "." .. Value.Name) or "None"
		elseif Element.Kind == "ColorPicker" then
			return { Value.R, Value.G, Value.B }
		end
		return Value
	end

	local function Decode(Element, Value)
		if Element.Kind == "Keybind" then
			local EnumName, ItemName = string.match(tostring(Value), "^(%a+)%.(.+)$")
			if not EnumName then return nil end
			local Ok, Item = pcall(function() return Enum[EnumName][ItemName] end)
			return Ok and Item or nil
		elseif Element.Kind == "ColorPicker" then
			return type(Value) == "table" and Color3.new(Value[1], Value[2], Value[3]) or nil
		end
		return Value
	end

	local function ListConfigs()
		if not CanSave then return {} end
		EnsureFolder()
		local Names = {}
		for _, Path in next, listfiles(Folder) do
			local Name = string.match(Path, "([^/\\]+)%.json$")
			if Name then table.insert(Names, Name) end
		end
		table.sort(Names)
		return Names
	end

	local function SaveConfig(Name)
		if not CanSave then return false, "executor can't write files" end
		if not Name or Name:gsub("%s", "") == "" then return false, "enter a config name" end
		EnsureFolder()
		local Data = {}
		for _, Element in next, Configs.Elements do
			local Ok, Value = pcall(Encode, Element)
			if Ok then Data[Element.Key] = Value end
		end
		writefile(Folder .. "/" .. Name .. ".json", HttpService:JSONEncode(Data))
		return true
	end

	local function LoadConfig(Name)
		if not CanSave then return false, "executor can't read files" end
		local Path = Folder .. "/" .. tostring(Name) .. ".json"
		if not isfile(Path) then return false, "config not found" end
		local Ok, Data = pcall(function() return HttpService:JSONDecode(readfile(Path)) end)
		if not Ok or type(Data) ~= "table" then return false, "config file is corrupt" end
		-- creation order, so settings that depend on each other load in the order they were built
		for _, Element in next, Configs.Elements do
			if Data[Element.Key] ~= nil then
				pcall(function() Element.Object:Update(Decode(Element, Data[Element.Key])) end)
			end
		end
		return true
	end

	local function GetAutoload()
		if CanSave and isfile(AutoloadFile) then return readfile(AutoloadFile) end
		return nil
	end

	local ConfigSection = Tab:AddSection({ Name = "configs", Side = "Right" })
	local NameBox = ConfigSection:AddTextBox({ Name = "config name", Placeholder = "name" })
	local List = ConfigSection:AddDropdown({ Name = "config list", Options = ListConfigs() })
	local AutoloadLabel = ConfigSection:AddLabel({ Text = "autoload: " .. (GetAutoload() or "none") })

	local function Result(Ok, Text, Err)
		Notify(Ok and Text or Err)
	end

	local function Refresh()
		List:Refresh(ListConfigs(), true)
	end

	ConfigSection:AddButton({ Name = "save config", ButtonText = "save", Callback = function()
		local Name = NameBox:Get() ~= "" and NameBox:Get() or List:Get()
		local Ok, Err = SaveConfig(Name)
		Result(Ok, "saved " .. tostring(Name), Err)
		Refresh()
	end })
	ConfigSection:AddButton({ Name = "load config", ButtonText = "load", Callback = function()
		local Ok, Err = LoadConfig(List:Get())
		Result(Ok, "loaded " .. tostring(List:Get()), Err)
	end })
	ConfigSection:AddButton({ Name = "refresh list", ButtonText = "refresh", Callback = Refresh })
	ConfigSection:AddButton({ Name = "set as autoload", ButtonText = "autoload", Callback = function()
		local Name = List:Get()
		if not Name then Notify("pick a config first") return end
		if not CanSave then Notify("executor can't write files") return end
		EnsureFolder()
		writefile(AutoloadFile, Name)
		AutoloadLabel:Update("autoload: " .. Name)
		Notify("autoload set to " .. Name)
	end })

	-- every tab is built by now, so the autoload config can reach all of them
	local Autoload = GetAutoload()
	if Autoload and Autoload ~= "" then
		local Ok, Err = LoadConfig(Autoload)
		Result(Ok, "loaded autoload config: " .. Autoload, "autoload failed: " .. tostring(Err))
	end
end

Environment.SaintsSupplementUnload = function()
	if not State.Running then
		return
	end
	State.Running = false
	Config.Enabled = false
	-- put back everything the Volzy features changed (walkspeed, hands, dive power, clothing, ...)
	for _, Cleanup in next, Cleanups do
		pcall(Cleanup)
	end
	for _, Connection in next, State.Connections do
		Connection:Disconnect()
	end
	Visuals.Destroy()
	if MobileGui then
		MobileGui:Destroy()
	end
	Library:Unload()
	Environment.SaintsSupplementUnload = nil
end

Notify("loaded, press LeftControl to open the menu")
