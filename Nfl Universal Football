-- // Receivers
local function GetReceivers()
	local List = {}
	local MyTeam = GetTeam(LocalPlayer)

	for _, Player in next, Players:GetPlayers() do
		if Player ~= LocalPlayer then
			local Character = Player.Character
			local Root = GetRoot(Character)
			local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
			if Root and Humanoid and Humanoid.Health > 0 then
				local Team = GetTeam(Player)
				if not Config.TeamOnly or MyTeam == nil or MyTeam == "" or MyTeam == 0 or Team == MyTeam then
					table.insert(List, { Name = Player.DisplayName, Player = Player, Model = Character, Root = Root, Humanoid = Humanoid })
				end
			end
		end
	end

	return List
end

local function IsAlive(Receiver)
	return Receiver ~= nil and Receiver.Root.Parent ~= nil and Receiver.Humanoid.Health > 0
end

-- The current target gets a head start so two receivers near the cursor don't swap every frame.
local StickyPixels = 45

local function GetClosestReceiver(Receivers, Current)
	local Mouse = UserInputService:GetMouseLocation()
	if IsTouch then
		Mouse = Camera.ViewportSize / 2
	end

	local Fov = Config.Fov > 0 and Config.Fov or math.huge
	local Closest, ClosestDistance = nil, math.huge
	for _, Receiver in next, Receivers do
		local Screen, OnScreen = Camera:WorldToViewportPoint(Receiver.Root.Position)
		if OnScreen then
			local Distance = (Vector2.new(Screen.X, Screen.Y) - Mouse).Magnitude
			if Distance <= Fov then
				if Current and Receiver.Model == Current.Model then
					Distance -= StickyPixels
				end
				if Distance < ClosestDistance then
					Closest, ClosestDistance = Receiver, Distance
				end
			end
		end
	end
	return Closest
end

-- // Tracking
local function UpdateTrack(Receiver, DeltaTime)
	local Track = State.Tracks[Receiver.Root]
	local Velocity = Flat(Receiver.Root.AssemblyLinearVelocity)

	if not Track then
		Track = { Velocity = Velocity }
		State.Tracks[Receiver.Root] = Track
	end

	Track.Velocity = Track.Velocity:Lerp(Velocity, math.clamp(DeltaTime * 10, 0, 1))

	local MoveDirection = Flat(Receiver.Humanoid.MoveDirection)
	if MoveDirection.Magnitude > 0.1 then
		Track.Direction = MoveDirection.Unit
		Track.Speed = math.max(Track.Velocity.Magnitude, Velocity.Magnitude)
	elseif Track.Velocity.Magnitude > 2 then
		Track.Direction = Track.Velocity.Unit
		Track.Speed = math.max(Track.Velocity.Magnitude, Velocity:Dot(Track.Direction))
	else
		Track.Direction = nil
		Track.Speed = 0
	end

	return Track
end

-- Time is real seconds. A receiver standing still still gets the ball in front, in the direction they face.
local function GetCatchPoint(Receiver, Time)
	local Track = State.Tracks[Receiver.Root] or UpdateTrack(Receiver, 1)
	local Position = Receiver.Root.Position + Vector3.new(0, Config.CatchHeight, 0)
	local Direction, Travel = Track.Direction, 0

	if Direction then
		Travel = Track.Speed * Time * Config.LeadScale / 100
	else
		local Facing = Flat(Receiver.Root.CFrame.LookVector)
		Direction = Facing.Magnitude > 0.01 and Facing.Unit or nil
	end
	if Direction then
		Position += Direction * (Travel + Config.LeadInFront)
	end
	return Position
end

-- // Bounds
-- The game measures out of bounds in field space from the field's Center part: end lines on X, sidelines on Z.
-- Every mode keeps these in its own FieldDimensions, and some fields are offset rather than centered.
local function GetFieldBounds()
	if not Config.AntiOob then
		return nil
	end
	local Settings = GetGameSettings()
	local Dimensions = Settings and Settings:FindFirstChild("FieldSettings")
	Dimensions = Dimensions and Dimensions:FindFirstChild("FieldDimensions")
	local Field = GetValue(Settings, "GameInstance")
	local Replicated = typeof(Field) == "Instance" and Field:FindFirstChild("Replicated")
	local Center = Replicated and Replicated:FindFirstChild("Center")
	local North, South = tonumber(GetValue(Dimensions, "NorthTDOOB")), tonumber(GetValue(Dimensions, "SouthTDOOB"))
	local Right, Left = tonumber(GetValue(Dimensions, "RightOOB")), tonumber(GetValue(Dimensions, "LeftOOB"))
	if not (Center and Center:IsA("BasePart") and North and South and Right and Left) then
		return nil
	end
	-- A margin wider than half the field would flip the range, so it shrinks to fit.
	local MarginX = math.min(Config.OobMargin, (South - North) / 2)
	local MarginZ = math.min(Config.OobMargin, (Left - Right) / 2)
	return {
		Center = Center.CFrame,
		North = North + MarginX,
		South = South - MarginX,
		Right = Right + MarginZ,
		Left = Left - MarginZ,
	}
end

-- Pulls a point back to the nearest spot inside the field, the same way the game's own ClampPosWithinBounds does.
local function KeepInBounds(Point, Bounds)
	if not Bounds then
		return Point, false
	end
	local Local = Bounds.Center:PointToObjectSpace(Point)
	local X = math.clamp(Local.X, Bounds.North, Bounds.South)
	local Z = math.clamp(Local.Z, Bounds.Right, Bounds.Left)
	if X == Local.X and Z == Local.Z then
		return Point, false
	end
	return Bounds.Center:PointToWorldSpace(Vector3.new(X, Local.Y, Z)), true
end

-- // Calculations
local function CalculateAngles(Distance, Height, Speed)
	local Speed2 = Speed * Speed
	local Discriminant = Speed2 * Speed2 - Gravity * (Gravity * Distance * Distance + 2 * Height * Speed2)
	if Discriminant < 0 then
		return nil
	end
	local Root = math.sqrt(Discriminant)
	return math.atan((Speed2 - Root) / (Gravity * Distance)), math.atan((Speed2 + Root) / (Gravity * Distance))
end

local function CalculateSpeed(Distance, Height, Angle)
	local Cos = math.cos(Angle)
	local Denominator = 2 * Cos * Cos * (Distance * math.tan(Angle) - Height)
	if Denominator <= 0 then
		return nil
	end
	return math.sqrt(Gravity * Distance * Distance / Denominator)
end

local function GetNormalAngle(Distance, Flattest)
	if not Config.AutoAngle then
		return math.rad(Config.CustomAngle)
	end
	local Profile = Profiles[Config.ThrowType]
	if not Profile or Config.ThrowType == "Bullet" then
		return Flattest
	end
	return math.rad(math.clamp(Profile.Base + Distance * Profile.PerStud, Profile.Min, Profile.Max))
end

-- Arc 0 is the flattest throw full power can make, 50 is the throw type's own angle and 100 is the highest.
local function GetArcAngle(Distance, Flattest, Highest)
	local Normal = math.clamp(GetNormalAngle(Distance, Flattest), Flattest, Highest)
	local Blend = math.clamp(Config.Arc, 0, 100) / 100
	if Blend <= 0.5 then
		return Flattest + (Normal - Flattest) * Blend * 2
	end
	return Normal + (Highest - Normal) * (Blend - 0.5) * 2
end

local function CalculateArc(Origin, Point)
	local Offset = Point - Origin
	local Distance = Flat(Offset).Magnitude
	local Height = Offset.Y
	if Distance < 1 then
		return nil
	end

	local Angle, Speed
	local Low, High = CalculateAngles(Distance, Height, MaxSpeed)
	if Low then
		Angle = GetArcAngle(Distance, Low, math.max(math.min(High, MaxArcAngle), Low))
		Speed = math.min(CalculateSpeed(Distance, Height, Angle) or MaxSpeed, MaxSpeed)
		-- The game won't throw under its minimum power, so short throws take the minimum-power angle on the same side.
		if Speed < MinSpeed then
			local SlowLow, SlowHigh = CalculateAngles(Distance, Height, MinSpeed)
			if SlowLow then
				Angle = Angle <= (SlowLow + SlowHigh) / 2 and SlowLow or SlowHigh
			end
			Speed = MinSpeed
		end
	else
		Angle = math.pi / 4 + math.atan2(Height, Distance) / 2
		Speed = MaxSpeed
	end

	return Angle, Speed, Distance / (Speed * math.cos(Angle)), Flat(Offset).Unit
end

local function CalculateThrow(Receiver)
	local MyRoot = GetRoot(LocalPlayer.Character)
	if not MyRoot or not IsAlive(Receiver) then
		return nil
	end

	local MyVelocity = Flat(MyRoot.AssemblyLinearVelocity)
	local Lag, Carry = 0, 0
	if Config.MoveCompensation then
		Lag, Carry = State.Lag, State.Carry
	end

	local RootPosition = MyRoot.Position - MyVelocity * Lag
	local Bounds = GetFieldBounds()
	local Time = 0.8
	local Point, Clamped = KeepInBounds(GetCatchPoint(Receiver, Time / TimeScale), Bounds)
	local Target = Point
	local Origin, Angle, Velocity, Launch

	for _ = 1, 6 do
		Origin = (CFrame.lookAt(RootPosition, Target) * ReleaseOffset).Position
		local NewAngle, NewSpeed, NewTime, Heading = CalculateArc(Origin, Point)
		if not NewAngle then
			return nil
		end
		Angle = NewAngle
		Velocity = (Heading * math.cos(NewAngle) + Vector3.new(0, math.sin(NewAngle), 0)) * NewSpeed
		Launch = Velocity - MyVelocity * Carry
		Target = Origin + Launch.Unit * 1000
		Time = math.min(NewTime, MaxAirTime)
		Point, Clamped = KeepInBounds(GetCatchPoint(Receiver, Time / TimeScale), Bounds)
	end

	return {
		Receiver = Receiver,
		Origin = Origin,
		Point = Point,
		Target = Target,
		Velocity = Velocity,
		MyVelocity = MyVelocity,
		Lag = Lag,
		Carry = Carry,
		Power = math.clamp(Launch.Magnitude / SpeedPerPower, MinPower, MaxPower),
		Angle = math.deg(Angle),
		Time = Time,
	}
end

-- A lock is kept on the player, so it survives them respawning; while they are down there is no target.
local function GetTarget(Receivers)
	if State.Locked then
		if State.Locked.Parent == Players then
			for _, Receiver in next, Receivers do
				if Receiver.Player == State.Locked then
					return Receiver
				end
			end
			return nil
		end
		State.Locked = nil
	end
	return GetClosestReceiver(Receivers, State.Target)
end

-- // Throw
-- The throw goes through the ReEvent inside the active game or minigame folder, not the one at the top of ReplicatedStorage.
local function GetThrowRemote()
	local Settings = GetGameSettings()
	local Remote = Settings and Settings:FindFirstChild("ReEvent")
	return Remote and Remote:IsA("RemoteEvent") and Remote or nil
end

-- Same checks the game makes before it throws, so a click as a runner or past the line of scrimmage does nothing.
local function CheckCanThrow()
	local Settings = GetGameSettings()
	local Character = LocalPlayer.Character
	local Head = Character and Character:FindFirstChild("Head")
	if not Settings or not Head or not HoldingBall() then
		return false
	end

	local Mechanics = GameVariables and GameVariables.Mechanics
	if Mechanics and (not Mechanics.BallEquipped or Mechanics.BallEquipType ~= Mechanics.DEF_QUARTERBACK or Mechanics.HandoffActive) then
		return false
	end

	local Ok, Allowed = pcall(function()
		local Status = Settings.GameStatus
		if not GetValue(Settings.MechanicsUsed, "Throwing") or not GetValue(Status, "Hiked") or not GetValue(Status, "ThrowEligible") then
			return false
		end
		if GetValue(Status, "DeadPlay") or GetValue(Status, "IsTimeout") then
			return false
		end

		-- Past the line is measured along the field's X axis, toward the end zone the offense scores in.
		local Field = Settings.GameInstance.Value.Replicated
		local Line = Field:FindFirstChild("ScrimmageLine")
		if Line then
			local Center = Field.Center.CFrame
			local LineX = Center:PointToObjectSpace(Line.Scrimmage.Position).X
			local HeadX = Center:PointToObjectSpace(Head.Position).X
			local Offense = Status.Offense.Value
			if (HeadX <= LineX and Status.NorthScorer.Value == Offense) or (HeadX >= LineX and Status.SouthScorer.Value == Offense) then
				return false
			end
		end
		return true
	end)
	return Ok and Allowed == true
end

local function FireThrow()
	-- CanThrow is from the last frame: the game's own click handler may already have marked the ball as gone this frame.
	if not State.Running or not Config.Enabled or not State.CanThrow or os.clock() - State.LastFire < 0.5 then
		return
	end
	local Remote = GetThrowRemote()
	if not Remote then
		return
	end

	local Receiver = State.Target
	if not IsAlive(Receiver) then
		Receiver = GetTarget(GetReceivers())
	end
	local Ok, Throw = pcall(CalculateThrow, Receiver)
	if not Ok or not Throw then
		return
	end

	State.CanThrow = false
	State.LastFire = os.clock()
	Remote:FireServer("Mechanics", "ThrowBall", { AutoThrow = false, Target = Throw.Target, Power = Throw.Power })
	State.Thrown = {
		Origin = Throw.Origin,
		Velocity = Throw.Velocity,
		MyVelocity = Throw.MyVelocity,
		Lag = Throw.Lag,
		Carry = Throw.Carry,
		Height = Throw.Point.Y,
		Time = Throw.Time,
		FiredAt = os.clock(),
		Until = os.clock() + Throw.Time / TimeScale + 0.5,
	}
end

-- Listens to the same inputs the game throws on. The game still sends its own throw about 0.27s later, after its
-- animation; by then the ball is already in the air, so the server ignores it.
-- A rebound throw key is only readable through require; without it the default C / R2 is used (left click always works).
local function GetThrowBind()
	local Bind = { Keyboard = "C", Controller = "ButtonR2" }
	pcall(function()
		local Saved = GameVariables.PlayerData[LocalPlayer.Name].ProfileData.ControlSettings.CatchHikeThrow
		Bind.Keyboard = Saved.Keyboard or Bind.Keyboard
		Bind.Controller = Saved.Controller or Bind.Controller
	end)
	return Bind
end

Connect(UserInputService.InputBegan, function(Input, Processed)
	if Processed or UserInputService:GetFocusedTextBox() then
		return
	end
	local Type = Input.UserInputType
	if Type == Enum.UserInputType.MouseButton1 then
		FireThrow()
	elseif Type == Enum.UserInputType.Keyboard then
		if Input.KeyCode.Name == GetThrowBind().Keyboard then
			FireThrow()
		end
	elseif Type == Enum.UserInputType.Gamepad1 then
		if Input.KeyCode.Name == GetThrowBind().Controller then
			FireThrow()
		end
	end
end)

Connect(UserInputService.TouchTapInWorld, function(_, Processed)
	if not Processed then
		FireThrow()
	end
end)

