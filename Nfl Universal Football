-- // Magnet Pull — hold M1 / R2: eases you toward a point just ahead of an airborne ball.
-- The target point and look direction are smoothed first, then you're lerped onto them
-- with a 1 - exp(-k*dt) alpha, so the pull feels the same at any frame rate.
do
	local smoothPullEnabled, isSmoothPulling = false, false
	local magnetSmoothness   = 0.05 -- 0.001 – 3
	local magnetRadius       = 100  -- studs
	local TARGET_SMOOTHNESS  = 10   -- target-point filtering
	local VELOCITY_THRESHOLD = 8    -- ball must be moving at least this fast
	local FORWARD_OFFSET     = 8    -- studs ahead of the ball along its velocity
	local HEIGHT_OFFSET      = 2    -- studs above the ball

	local smoothedTarget, smoothedLook

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.IgnoreWater = true

	local function resetSmoothing()
		smoothedTarget, smoothedLook = nil, nil
	end

	local function smoothAlpha(speed, dt)
		return math.clamp(1 - math.exp(-speed * dt), 0, 1)
	end

	local function hasBall(char)
		for _, obj in ipairs(char:GetDescendants()) do
			if obj:IsA("Weld") or obj:IsA("Motor6D") or obj:IsA("WeldConstraint") then
				local p0, p1 = obj.Part0, obj.Part1
				if (p0 and p0.Name == "Football") or (p1 and p1.Name == "Football") then
					return true
				end
			end
		end
		return false
	end

	local function isBallInAir(ball, char)
		if ball.AssemblyLinearVelocity.Magnitude <= VELOCITY_THRESHOLD then
			return false
		end
		raycastParams.FilterDescendantsInstances = { ball, char }
		return Workspace:Raycast(ball.Position, Vector3.new(0, -4, 0), raycastParams) == nil
	end

	local function isPullInput(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1
			or (input.UserInputType == Enum.UserInputType.Gamepad1 and input.KeyCode == Enum.KeyCode.ButtonR2)
	end

	Connect(UserInputService.InputBegan, function(input, gp)
		if gp then return end
		if smoothPullEnabled and isPullInput(input) then isSmoothPulling = true end
	end)
	Connect(UserInputService.InputEnded, function(input)
		if isPullInput(input) then isSmoothPulling = false end
	end)

	Connect(RunService.RenderStepped, function(dt)
		if not smoothPullEnabled or not isSmoothPulling then
			resetSmoothing()
			return
		end

		local char = plr.Character
		if not char then
			resetSmoothing()
			return
		end

		local hrp  = char:FindFirstChild("HumanoidRootPart")
		local ball = getFootball()
		if not hrp or not hrp.Parent or not ball or not ball.Parent then return end

		if hasBall(char)
			or (ball.Position - hrp.Position).Magnitude > magnetRadius
			or not isBallInAir(ball, char) then
			resetSmoothing()
			return
		end

		local velocity = ball.AssemblyLinearVelocity
		local offset   = velocity.Magnitude > VELOCITY_THRESHOLD and velocity.Unit * FORWARD_OFFSET or Vector3.zero
		local rawTarget = ball.Position + offset + Vector3.new(0, HEIGHT_OFFSET, 0)

		local direction = ball.Position - hrp.Position
		if direction.Magnitude <= 0.001 then return end
		local rawLook = direction.Unit

		local targetAlpha = smoothAlpha(TARGET_SMOOTHNESS, dt)
		smoothedTarget = smoothedTarget and smoothedTarget:Lerp(rawTarget, targetAlpha) or rawTarget

		if not smoothedLook then
			smoothedLook = rawLook
		else
			smoothedLook = smoothedLook:Lerp(rawLook, targetAlpha)
			smoothedLook = smoothedLook.Magnitude > 0.001 and smoothedLook.Unit or rawLook
		end

		local targetCFrame = CFrame.new(smoothedTarget, smoothedTarget + smoothedLook)
		hrp.CFrame = hrp.CFrame:Lerp(targetCFrame, smoothAlpha(magnetSmoothness * 60, dt))
	end)

	local Section = CatchingTab:AddSection({ Name = "magnet pull", Side = "Left" })
	Section:AddLabel({ Text = "hold M1 or R2 to smoothly pull toward an airborne ball" })
	Section:AddToggle({ Name = "magnet pull (M1 / R2)", Default = false, Callback = function(v)
		smoothPullEnabled = v
		if not v then isSmoothPulling = false end
	end })
	Section:AddTextBox({ Name = "magnet smoothness", Default = "0.05", Placeholder = "0.001 - 3", Callback = function(v)
		local num = tonumber(v)
		if num then magnetSmoothness = math.clamp(num, 0.001, 3) end
	end })
	Section:AddSlider({ Name = "pull radius", Min = 5, Max = 500, Default = 100, Suffix = " studs", Callback = function(v) magnetRadius = v end })
end

-- // Arm Size (Toss Up Machine) — resizes your hands (R15 LeftHand / RightHand) and sets
-- their transparency while on. Size 0 = your normal hand size. R1 / L1 step the size.
do
	local HAND_NAMES = { "LeftHand", "RightHand" }
	local armSizeEnabled  = false
	local currentSize     = 0
	local leftTransValue  = 1
	local rightTransValue = 1
	local originalHands   = {} -- [hand] = { Size, Transparency }
	local SizeSlider

	local function eachHand(fn)
		local char = plr.Character
		if not char then return end
		for _, name in ipairs(HAND_NAMES) do
			local hand = char:FindFirstChild(name)
			if hand and hand:IsA("BasePart") then fn(hand, name) end
		end
	end

	local function restoreHands()
		for hand, orig in pairs(originalHands) do
			if hand.Parent then
				hand.Size = orig.Size
				hand.Transparency = orig.Transparency
			end
		end
		originalHands = {}
	end
	table.insert(Cleanups, restoreHands)

	Connect(RunService.Heartbeat, function()
		if not armSizeEnabled then return end
		eachHand(function(hand, name)
			if not originalHands[hand] then
