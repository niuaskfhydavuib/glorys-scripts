local Footballs = setmetatable({}, { __mode = "k" })

local function TrackFootball(Object)
	if Object.Name == "Football" and Object:IsA("BasePart") then
		Footballs[Object] = true
	end
end

for _, Object in next, workspace:GetDescendants() do
	TrackFootball(Object)
end
Connect(workspace.DescendantAdded, TrackFootball)

local function GetBallVelocity(Ball)
	local Mover = Ball:FindFirstChildOfClass("LinearVelocity")
	if Mover and Mover.Enabled then
		return Mover.VectorVelocity
	end
	return nil
end

local function GetFlightTime(Position, Velocity, Height)
	local Discriminant = Velocity.Y * Velocity.Y + 2 * Gravity * (Position.Y - Height)
	if Discriminant < 0 then
		return nil
	end
	return (Velocity.Y + math.sqrt(Discriminant)) / Gravity
end

-- Other players' balls fly around too, so a match has to sit near the predicted path and head the same way.
local function FindThrownBall(Thrown)
	local Elapsed = (os.clock() - Thrown.FiredAt) * TimeScale
	local Expected = Thrown.Origin + Thrown.Velocity * Elapsed + GravityVector * (0.5 * Elapsed * Elapsed)
	local Heading = Flat(Thrown.Velocity).Unit
	local Closest, ClosestDistance = nil, 6 + 12 * Elapsed

	for Ball in next, Footballs do
		local Velocity = Ball.Parent and GetBallVelocity(Ball)
		local Moving = Velocity and Flat(Velocity)
		if Moving and Moving.Magnitude > 1 and Moving.Unit:Dot(Heading) > 0.8 then
			local Distance = (Ball.Position - Expected).Magnitude
			if Distance < ClosestDistance then
				Closest, ClosestDistance = Ball, Distance
			end
		end
	end
	return Closest
end

local function UpdateCalibration(Thrown, Ball)
	local Mine = Thrown.MyVelocity
	local Velocity = GetBallVelocity(Ball)
	if not Velocity or Mine.Magnitude < 4 then
		return
	end

	local Expected = Flat(Thrown.Velocity)
	local Observed = Flat(Velocity)
	if Observed.Magnitude < 1 then
		return
	end

	local CarryError = (Observed - Expected):Dot(Mine) / Mine:Dot(Mine)
	State.Carry = math.clamp(State.Carry + (Thrown.Carry + math.clamp(CarryError, -1, 1) - State.Carry) * 0.5, -0.25, 1.2)

	local Heading = Observed.Unit
	local Side = Vector3.new(-Heading.Z, 0, Heading.X)
	local Sideways = Mine:Dot(Side)
	if math.abs(Sideways) > 4 then
		local LagError = -Flat(Ball.Position - Thrown.Origin):Dot(Side) / Sideways
		State.Lag = math.clamp(State.Lag + (Thrown.Lag + math.clamp(LagError, -0.2, 0.2) - State.Lag) * 0.5, 0, 0.4)
	end
end

local function UpdateThrownBall(Thrown)
	if Thrown.Ball then
		if not Thrown.Ball.Parent or not GetBallVelocity(Thrown.Ball) then
			Thrown.Until = math.min(Thrown.Until, os.clock() + 0.2)
			Thrown.Ball = nil
			Thrown.Landed = true
		end
		return
	end

	if Thrown.Landed or os.clock() - Thrown.FiredAt > 1 then
		return
	end

	local Ball = FindThrownBall(Thrown)
	if Ball then
		Thrown.Ball = Ball
		if Config.MoveCompensation then
			UpdateCalibration(Thrown, Ball)
		end
	end
end

