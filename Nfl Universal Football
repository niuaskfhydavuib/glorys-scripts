	local function GetAxisFrame(Position, Axis)
		local Up = Vector3.yAxis - Axis * Axis.Y
		if Up.Magnitude < 1e-3 then
			Up = Vector3.xAxis
		end
		return CFrame.fromMatrix(Position, Axis, Up.Unit)
	end

	local function UpdateCurve(Origin, Velocity, Time)
		local Landing = Origin + Velocity * Time + GravityVector * (0.5 * Time * Time)
		local Control0 = Origin + Velocity * (Time / 3)
		local Control1 = Landing - (Velocity + GravityVector * Time) * (Time / 3)

		Start.WorldCFrame = GetAxisFrame(Origin, (Control0 - Origin).Unit)
		Finish.WorldCFrame = GetAxisFrame(Landing, (Control1 - Landing).Unit)

		local Size0, Size1 = (Control0 - Origin).Magnitude, -(Control1 - Landing).Magnitude
		Glow.CurveSize0, Glow.CurveSize1 = Size0, Size1
		Core.CurveSize0, Core.CurveSize1 = Size0, Size1
		return Landing
	end

	function Visuals.UpdateAccent(Color)
		local Bright = Color:Lerp(Color3.new(1, 1, 1), 0.35)
		Glow.Color = ColorSequence.new(Color)
		Core.Color = ColorSequence.new(Bright, Color)
		Marker.Color = Color
		Highlight.FillColor = Color
		Highlight.OutlineColor = Bright
		AccentBar.BackgroundColor3 = Color
		TypeLabel.TextColor3 = Bright
	end

	function Visuals.Update(Throw, Target)
		local Arc = nil
		local Thrown = State.Thrown
		if Thrown and os.clock() > Thrown.Until then
			State.Thrown, Thrown = nil, nil
		end
		if Thrown then
			UpdateThrownBall(Thrown)
		end
		if Thrown and Config.BeamMode ~= "While Aiming" then
			Arc = Thrown
		elseif Throw and Config.BeamMode ~= "On Throw" and HoldingBall() then
			Arc = Throw
		end

		local ShowArc = Arc ~= nil and Config.Beam
		local Origin, Velocity, Time = nil, nil, nil
		if ShowArc then
			Origin, Velocity, Time = Arc.Origin, Arc.Velocity, Arc.Time
			if Arc == Thrown then
				local Ball = Thrown.Ball
				local BallVelocity = Ball and GetBallVelocity(Ball)
				if BallVelocity then
					Origin, Velocity = Ball.Position, BallVelocity
					Time = GetFlightTime(Origin, Velocity, Thrown.Height)
				elseif Thrown.Landed then
					Time = nil
				else
					local Elapsed = math.min((os.clock() - Thrown.FiredAt) * TimeScale, Thrown.Time)
					Origin = Thrown.Origin + Thrown.Velocity * Elapsed + GravityVector * (0.5 * Elapsed * Elapsed)
					Velocity = Thrown.Velocity + GravityVector * Elapsed
					Time = Thrown.Time - Elapsed
				end
			end
			ShowArc = Time ~= nil and Time > 0.03
		end

		Glow.Enabled = ShowArc
		Core.Enabled = ShowArc
		Marker.Transparency = ShowArc and 0.35 or 1

		if ShowArc then
			local Landing = UpdateCurve(Origin, Velocity, Time)
			Marker.CFrame = CFrame.new(Landing) * CFrame.Angles(0, 0, math.pi / 2) * CFrame.Angles(os.clock() * 2 % (math.pi * 2), 0, 0)
		end

		Highlight.Adornee = Target and Target.Model or nil
		Highlight.Enabled = Config.Highlight and Target ~= nil

		Card.Visible = Config.Card and Target ~= nil
		if Card.Visible then
			NameLabel.Text = (State.Locked and "LOCKED  " or "") .. Target.Name
			TypeLabel.Text = string.upper(Config.ThrowType)
			if Throw then
				InfoLabel.Text = string.format("power %d   angle %d°   air %.1fs   %d studs", math.floor(Throw.Power + 0.5), math.floor(Throw.Angle + 0.5), Throw.Time, math.floor(Flat(Throw.Point - Throw.Origin).Magnitude + 0.5))
			else
				InfoLabel.Text = "out of reach"
			end
		end
	end

	function Visuals.Destroy()
		Folder:Destroy()
		Start:Destroy()
		Finish:Destroy()
		Highlight:Destroy()
		CardGui:Destroy()
	end

	Visuals.UpdateAccent(Config.Accent)
end

