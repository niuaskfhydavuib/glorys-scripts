end

-- // Auto Side Tech — while a thrown ball is in the air and within the radius, turns you
-- sideways to its flight path (90 degrees off its travel direction) so it always comes in
-- on your right side. A thrown UF ball is driven by a LinearVelocity mover.
do
	local sideTechEnabled = false
	local TURN_SPEED   = 20  -- higher = snappier turn
	local ballRadius   = 25  -- studs: only reacts while the ball is this close to you
	local turning      = false

	local function isHeld(ball)
		local model = ball:FindFirstAncestorOfClass("Model")
		return model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
	end

	-- velocity of a ball in flight, or nil if it isn't flying
	local function flightOf(ball)
		local mover = ball:FindFirstChildOfClass("LinearVelocity")
		if mover and mover.Enabled then
			return mover.VectorVelocity
		end
		local vel = ball.AssemblyLinearVelocity
		if vel.Magnitude > 8 then
			return vel
		end
		return nil
	end

	local function release()
		if turning then
			turning = false
			if humanoid then humanoid.AutoRotate = true end
		end
	end
	table.insert(Cleanups, release)

	-- Dive check: turning you mid-dive fights the dive animation, so side tech lets go the moment
	-- the game sends your dive, ReEvent:FireServer("Mechanics", "Dive"), and stays off until
	-- you've landed and are upright again.
	-- Seeing that call needs a __namecall hook. It is read-only: it only notes the dive and passes
	-- every call through unchanged, makes no namecalls of its own, and is installed the first time
	-- side tech is turned on (executing the script installs no hook).
	local DIVE_MIN_TIME = 0.35 -- seconds before a dive can end (it starts on the ground)
	local UPRIGHT_UP_Y = 0.9   -- root UpVector.Y above this (and on the ground) = the dive is over
	local diving = false
	local diveFiredAt = 0
	local diveHookInstalled = false

	local function installDiveHook()
		if diveHookInstalled then return end
		if not (hookmetamethod and getnamecallmethod) then
			Notify("executor can't hook remotes, side tech won't pause for dives")
			diveHookInstalled = true
			return
		end
		diveHookInstalled = true
		local wrap = newcclosure or function(f) return f end
		local OldNamecall
		OldNamecall = hookmetamethod(game, "__namecall", wrap(function(Self, ...)
			if State.Running and getnamecallmethod() == "FireServer" then
				local Action, Kind = ...
				if Action == "Mechanics" and Kind == "Dive" then
					diving = true
					diveFiredAt = os.clock()
				end
			end
			return OldNamecall(Self, ...)
		end))
	end

	Connect(RunService.RenderStepped, function(dt)
		if not sideTechEnabled or not humanoid or not humanoidRootPart or not humanoidRootPart.Parent then
			release()
			return
		end

		-- a dive lasts until you're back on the ground and upright
		if diving and os.clock() - diveFiredAt > DIVE_MIN_TIME
			and humanoid.FloorMaterial ~= Enum.Material.Air
			and humanoidRootPart.CFrame.UpVector.Y > UPRIGHT_UP_Y then
			diving = false
		end
		if diving then
			release()
			return
		end

		local ball = getFootball()
		if not ball or not ball.Parent then release() return end

		local myPos = humanoidRootPart.Position
		if (ball.Position - myPos).Magnitude > ballRadius or isHeld(ball) then release() return end

		local vel = flightOf(ball)
		if not vel then release() return end

		local travel = Vector3.new(vel.X, 0, vel.Z)
		if travel.Magnitude < 1 then return end -- dropping straight down; keep the current facing
		travel = travel.Unit

		-- face 90 degrees off the flight path, turned so the ball comes in on your right
		local side = Vector3.new(travel.Z, 0, -travel.X)

		-- AutoRotate would turn you back toward your movement direction every frame
		turning = true
		humanoid.AutoRotate = false
		local goal = CFrame.lookAt(myPos, myPos + side)
		humanoidRootPart.CFrame = humanoidRootPart.CFrame:Lerp(goal, math.clamp(1 - math.exp(-TURN_SPEED * dt), 0, 1))
	end)

	local Section = CatchingTab:AddSection({ Name = "auto side tech", Side = "Left" })
	Section:AddLabel({ Text = "turns you sideways so the ball always comes in on your right" })
	Section:AddToggle({ Name = "auto side tech", Default = false, Callback = function(v)
		sideTechEnabled = v
		if v then installDiveHook() else release() end
	end })
	Section:AddSlider({ Name = "ball radius", Min = 1, Max = 50, Default = 25, Suffix = " studs", Callback = function(v) ballRadius = v end })
end

